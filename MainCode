// ─── CALENDAR TAB ─────────────────────────────────────────────────────────────

function CalendarTab({ events, onEventClick, onAddEvent }) {
  const [year, setYear] = useState(2026);
  const [month, setMonth] = useState(3); // April
  const [selectedDay, setSelectedDay] = useState(10);

  const cells = buildCalendar(year, month);
  const dateStr = `${year}-${String(month+1).padStart(2,'0')}`;
  const eventsByDay = {};
  events.forEach(e => { const d = parseInt(e.date.split('-')[2]); if (e.date.startsWith(dateStr)) { if (!eventsByDay[d]) eventsByDay[d] = []; eventsByDay[d].push(e); } });
  const selKey = `${dateStr}-${String(selectedDay).padStart(2,'0')}`;
  const dayEvents = events.filter(e => e.date === selKey).sort((a,b) => a.time.localeCompare(b.time));

  const prevMonth = () => { if (month === 0) { setYear(y=>y-1); setMonth(11); } else setMonth(m=>m-1); setSelectedDay(1); };
  const nextMonth = () => { if (month === 11) { setYear(y=>y+1); setMonth(0); } else setMonth(m=>m+1); setSelectedDay(1); };

  return (
    <div className="content-scroll" style={{ padding:'0 16px 100px' }}>
      {/* Month nav */}
      <div style={{ display:'flex', alignItems:'center', justifyContent:'space-between', padding:'16px 0 12px' }}>
        <button className="btn-icon" onClick={prevMonth}><Icon name="chevLeft" size={20} color="#374151"/></button>
        <span style={{ fontSize:17, fontWeight:700 }}>{MONTHS[month]} {year}</span>
        <button className="btn-icon" onClick={nextMonth}><Icon name="chevRight" size={20} color="#374151"/></button>
      </div>

      {/* Day headers */}
      <div className="cal-grid" style={{ marginBottom:4 }}>
        {DAYS.map(d => <div key={d} style={{ textAlign:'center', fontSize:11, fontWeight:600, color:'#9CA3AF', padding:'4px 0' }}>{d}</div>)}
      </div>

      {/* Calendar grid */}
      <div className="card" style={{ padding:10, marginBottom:16 }}>
        <div className="cal-grid">
          {cells.map((cell, i) => {
            const isToday = cell.current && year === 2026 && month === 3 && cell.day === 10;
            const isSel = cell.current && cell.day === selectedDay;
            const dots = cell.current ? (eventsByDay[cell.day] || []) : [];
            return (
              <div key={i} className={`cal-cell${isToday && !isSel ? ' today' : ''}${isSel ? ' selected' : ''}${!cell.current ? ' other-month' : ''}`}
                onClick={() => cell.current && setSelectedDay(cell.day)}>
                <span className="cal-day-num">{cell.day}</span>
                <div className="cal-day-dots">
                  {dots.slice(0,3).map((e,j) => <div key={j} className="cal-dot" style={{ background: getTagColor(e.tag) }}/>)}
                </div>
              </div>
            );
          })}
        </div>
      </div>

      {/* Day events */}
      <div style={{ fontSize:13, fontWeight:600, color:'#9CA3AF', marginBottom:10, textTransform:'uppercase', letterSpacing:0.5 }}>
        {selectedDay} {MONTHS[month].slice(0,3)} · {dayEvents.length} event{dayEvents.length !== 1 ? 's' : ''}
      </div>
      {dayEvents.length === 0 ? (
        <div style={{ textAlign:'center', padding:'32px 0', color:'#9CA3AF' }}>
          <Icon name="calendar" size={40} color="#E5E7EB"/>
          <p style={{ marginTop:12, fontSize:15 }}>No events this day</p>
          <button className="btn-ghost" onClick={onAddEvent} style={{ marginTop:8 }}>+ Add event</button>
        </div>
      ) : dayEvents.map(e => <EventCard key={e.id} event={e} onClick={() => onEventClick(e)}/>)}
    </div>
  );
}

