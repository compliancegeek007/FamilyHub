          <div className="modal-footer">
            <button className="btn-primary" onClick={() => { onImport(items.filter(i=>selectedItems.includes(i.id))); onClose(); }} disabled={!selectedItems.length}>
              <Icon name="checkCircle" size={18} color="white"/>
              Import {selectedItems.length} Event{selectedItems.length!==1?'s':''}
            </button>
          </div>
        )}
      </div>
    </div>
  );
}

