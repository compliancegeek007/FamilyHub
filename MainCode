    .source-card:active { transform: scale(0.98); border-color: var(--accent); }
    .source-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; }

    /* Segmented control */
    .seg-ctrl { background: var(--bg); border-radius: 12px; padding: 3px; display: flex; }
    .seg-btn { flex: 1; padding: 8px; border: none; background: transparent; border-radius: 10px; font-size: 13px; font-weight: 600; cursor: pointer; color: var(--subtext); transition: all 0.2s; }
    .seg-btn.active { background: white; color: var(--text); box-shadow: 0 1px 4px rgba(0,0,0,0.1); }

    /* Checkbox */
    .check-row { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--border); cursor: pointer; }
    .check-row:last-child { border-bottom: none; }
    .checkbox { width: 22px; height: 22px; border-radius: 7px; border: 2px solid var(--border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all 0.2s; }
    .checkbox.checked { background: var(--accent); border-color: var(--accent); }

    /* Loading spinner */
    .spinner { width: 20px; height: 20px; border: 2px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin 0.7s linear infinite; }

    /* Scrollable tag row */
    .tag-scroll { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: none; }
