    .tag-filter { padding: 6px 14px; border-radius: 100px; font-size: 12px; font-weight: 600; border: 1.5px solid var(--border); background: white; cursor: pointer; white-space: nowrap; color: var(--subtext); transition: all 0.15s; }
    .tag-filter.active { background: var(--text); color: white; border-color: var(--text); }

    /* Avatar group */
    .avatar-group { display: flex; }
    .avatar-group .avatar { border: 2px solid white; margin-left: -8px; }
    .avatar-group .avatar:first-child { margin-left: 0; }

    /* Status badge */
    .status-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    .status-online { background: #10B981; }
    .status-pending { background: #F59E0B; }
  </style>
</head>
