  const handleRequest = () => {
    if (!newTag.trim()) return;
    setRequesting(true);
    setTimeout(() => { onRequestTag(newTag.trim().toUpperCase()); setNewTag(''); setRequesting(false); }, 800);
  };

  return (
    <div className="content-scroll" style={{ padding:'0 16px 100px' }}>
      {/* Approved tags */}
      <div style={{ padding:'16px 0 8px' }}>
        <div style={{ fontSize:12, fontWeight:600, color:'#9CA3AF', letterSpacing:0.5, textTransform:'uppercase', marginBottom:12 }}>Active Tags ({approvedTags.length})</div>
