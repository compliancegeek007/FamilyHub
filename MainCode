            <div className="fade-up">
              <p style={{ color:'#6B7280', fontSize:15, lineHeight:1.6, marginBottom:28 }}>{config.desc}</p>
              <div style={{ background:'#F8FAFC', borderRadius:16, padding:16, marginBottom:24 }}>
