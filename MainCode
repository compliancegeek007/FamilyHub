            <div style={{ textAlign:'center', padding:'40px 0', color:'#9CA3AF' }}>
              <Icon name="bell" size={40} color="#E5E7EB"/>
              <p style={{ marginTop:12 }}>No notifications yet</p>
            </div>
          ) : notifs.map((n, i) => (
            <div key={i} style={{ display:'flex', gap:12, padding:'12px 0', borderBottom: i<notifs.length-1?'1px solid #F3F4F6':'none' }}>
              <div style={{ width:40, height:40, borderRadius:12, background:'#F0F4FF', display:'flex', alignItems:'center', justifyContent:'center', flexShrink:0 }}>
                <span style={{ fontSize:18 }}>{n.icon}</span>
              </div>
              <div>
                <div style={{ fontWeight:600, fontSize:14 }}>{n.title}</div>
                <div style={{ fontSize:12, color:'#6B7280', marginTop:2 }}>{n.body}</div>
                <div style={{ fontSize:11, color:'#9CA3AF', marginTop:3 }}>{n.time}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

// ─── MAIN APP ─────────────────────────────────────────────────────────────────

function App() {
  const [screen, setScreen] = useState('login');
  const [tab, setTab] = useState('calendar');
  const [events, setEvents] = useState(INITIAL_EVENTS);
  const [pendingTags, setPendingTags] = useState(PENDING_TAGS);
  const [approvedTags, setApprovedTags] = useState(Object.keys(TAG_COLORS));
  const [toast, setToast] = useState(null);
  const [eventModal, setEventModal] = useState(null); // null | 'add' | event object
  const [detailEvent, setDetailEvent] = useState(null);
  const [ingestionSource, setIngestionSource] = useState(null);
  const [notifPanel, setNotifPanel] = useState(false);
  const [notifications, setNotifications] = useState([
    { icon:'📅', title:'Priya added an event', body:'Yoga class – Tuesday 7pm', time:'2 min ago' },
    { icon:'✈️', title:'Upcoming: Dubai Trip', body:'Tomorrow at 08:15 · Heathrow T3', time:'1 hr ago' },
    { icon:'🎂', title:"Don't forget! Priya's Birthday", body:'25 Apr · Nobu, Park Lane', time:'3 hr ago' },
  ]);

  const showToast = (msg, icon) => {
    setToast({ msg, icon });
    setTimeout(() => setToast(null), 3000);
  };

  const handleSaveEvent = (form) => {
    if (eventModal && eventModal !== 'add') {
      setEvents(prev => prev.map(e => e.id === form.id ? form : e));
      showToast('Event updated', '✏️');
      const n = { icon:'✏️', title:`${FAMILY[0].name} updated an event`, body: form.title, time:'Just now' };
      setNotifications(p => [n, ...p]);
    } else {
      const newEv = { ...form, id: Date.now() };
      setEvents(prev => [...prev, newEv]);
      showToast('Event added & family notified!', '📅');
      const n = { icon:'📅', title:`${FAMILY[0].name} added an event`, body: form.title, time:'Just now' };
      setNotifications(p => [n, ...p]);
    }
    setEventModal(null);
    setDetailEvent(null);
  };

  const handleDeleteEvent = (id) => {
    setEvents(prev => prev.filter(e => e.id !== id));
    setDetailEvent(null);
    showToast('Event deleted', '🗑️');
  };

  const handleApproveTag = (tag) => {
    setPendingTags(p => p.filter(t => t.id !== tag.id));
    setApprovedTags(p => [...p, tag.name]);
    showToast(`Tag "${tag.name}" approved!`, '✅');
    const n = { icon:'🏷️', title:'Tag approved', body:`"${tag.name}" is now available to everyone`, time:'Just now' };
    setNotifications(prev => [n, ...prev]);
  };

  const handleRejectTag = (id) => {
    setPendingTags(p => p.filter(t => t.id !== id));
    showToast('Tag declined', '❌');
  };

  const handleRequestTag = (name) => {
    const t = { id: 't'+Date.now(), name, submittedBy:1, submittedName:'Punit', note:'' };
    setPendingTags(p => [...p, t]);
    showToast(`"${name}" sent for approval`, '🏷️');
  };

  const handleImport = (items) => {
    const imported = items.map(i => ({ id: Date.now()+Math.random(), title: i.title, date: i.date, time: i.time, endTime:'', tag: i.tag, members:[1,2,3,4], note:'Imported automatically', location:'' }));
    setEvents(p => [...p, ...imported]);
    showToast(`${items.length} event${items.length>1?'s':''} imported!`, '⚡');
  };

  const handleNotifyFamily = () => {
    showToast('Family notified via WhatsApp!', '💬');
    const n = { icon:'💬', title:'WhatsApp sent to 3 members', body:'Event details shared with Priya, Arjun & Mia', time:'Just now' };
    setNotifications(p => [n, ...p]);
    setDetailEvent(null);
  };

  const pendingCount = pendingTags.length;

  if (screen === 'login') return <LoginScreen onLogin={() => setScreen('app')}/>;

  const TABS = [
    { id:'calendar', label:'Calendar', icon:'calendar' },
    { id:'events', label:'Events', icon:'list' },
    { id:'family', label:'Family', icon:'users' },
    { id:'tags', label:'Tags', icon:'tag', badge: pendingCount },
    { id:'settings', label:'Settings', icon:'settings' },
  ];

  return (
    <div className="screen">
      {/* Header */}
      <div className="app-header">
        <div>
          <div className="header-title">
            {tab === 'calendar' && '📅 Calendar'}
            {tab === 'events' && '✦ All Events'}
            {tab === 'family' && '👨‍👩‍👧‍👦 Family'}
            {tab === 'tags' && '🏷️ Tags'}
            {tab === 'settings' && '⚙️ Settings'}
          </div>
          <div className="header-sub">Bafna Family · April 2026</div>
        </div>
        <div style={{ display:'flex', gap:8, alignItems:'center' }}>
          <button className="btn-icon" style={{ position:'relative' }} onClick={() => setNotifPanel(true)}>
            <Icon name="bell" size={20} color="#374151"/>
            {notifications.length > 0 && <div style={{ position:'absolute', top:6, right:6, width:8, height:8, borderRadius:50, background:'#FF6B6B', border:'2px solid white' }}/>}
          </button>
          <MemberAvatar member={FAMILY[0]} size="sm"/>
        </div>
      </div>

      {/* Tab content */}
      <div style={{ flex:1, overflow:'hidden', position:'relative' }}>
        {tab === 'calendar' && <CalendarTab events={events} onEventClick={setDetailEvent} onAddEvent={() => setEventModal('add')}/>}
        {tab === 'events' && <EventsTab events={events} onEventClick={setDetailEvent} onAddEvent={() => setEventModal('add')}/>}
        {tab === 'family' && <FamilyTab onShowIngestion={setIngestionSource}/>}
        {tab === 'tags' && <TagsTab pendingTags={pendingTags} approvedTags={approvedTags} onApprove={handleApproveTag} onReject={handleRejectTag} onRequestTag={handleRequestTag}/>}
        {tab === 'settings' && <SettingsTab/>}
      </div>

      {/* FAB */}
      {(tab === 'calendar' || tab === 'events') && (
        <button className="fab" onClick={() => setEventModal('add')}>
          <Icon name="plus" size={24} color="white"/>
        </button>
      )}

      {/* Bottom nav */}
      <div className="bottom-nav">
        {TABS.map(t => (
          <div key={t.id} className={`nav-item${tab===t.id?' active':''}`} onClick={() => setTab(t.id)}>
            <div style={{ position:'relative' }}>
              <Icon name={t.icon} size={22} color={tab===t.id?'white':'rgba(255,255,255,0.35)'}/>
              {t.badge > 0 && <div className="nav-badge" style={{ position:'absolute', top:-4, right:-8 }}>{t.badge}</div>}
            </div>
            <span>{t.label}</span>
          </div>
        ))}
      </div>

      {/* Modals */}
      {detailEvent && (
        <EventDetailModal event={detailEvent} onClose={() => setDetailEvent(null)}
          onEdit={() => { setEventModal(detailEvent); setDetailEvent(null); }}
          onDelete={handleDeleteEvent} onNotify={handleNotifyFamily}/>
      )}
      {eventModal && (
        <EventModal event={eventModal === 'add' ? null : eventModal}
          existingTags={approvedTags} onClose={() => setEventModal(null)} onSave={handleSaveEvent}/>
      )}
      {ingestionSource && (
        <IngestionModal source={ingestionSource} onClose={() => setIngestionSource(null)} onImport={handleImport}/>
      )}
      {notifPanel && (
        <NotificationPanel notifs={notifications} onClose={() => setNotifPanel(false)}/>
      )}

      {/* Toast */}
      {toast && <Toast msg={toast.msg} icon={toast.icon}/>}
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<App/>);
</script>
</body>
</html>
