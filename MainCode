  const toggle = (id) => setSelectedItems(p => p.includes(id) ? p.filter(x=>x!==id) : [...p, id]);

  const handleScan = () => {
    setStep('scanning');
    setTimeout(() => { setStep('results'); setSelectedItems(items.map(i=>i.id)); }, 2200);
  };

  return (
    <div className="modal-overlay fade-in" onClick={onClose}>
      <div className="modal-sheet slide-up" onClick={e => e.stopPropagation()}>
        <div className="modal-handle"/>
        <div className="modal-header">
