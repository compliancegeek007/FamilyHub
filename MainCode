                  <div key={f} style={{ display:'flex', alignItems:'center', gap:10, padding:'8px 0' }}>
                    <Icon name="checkCircle" size={18} color="#10B981"/>
                    <span style={{ fontSize:14, color:'#374151' }}>{f}</span>
                  </div>
                ))}
              </div>
              <button className="btn-primary" style={{ background: config.color }} onClick={handleScan}>
                {config.btnLabel}
              </button>
            </div>
          )}

          {step === 'scanning' && (
            <div style={{ textAlign:'center', padding:'48px 0' }}>
              <div style={{ width:64, height:64, borderRadius:50, background:'#F0F4FF', display:'flex', alignItems:'center', justifyContent:'center', margin:'0 auto 20px', animation:'pulse 1.5s ease infinite' }}>
                <span style={{ fontSize:28 }}>{config.icon}</span>
              </div>
              <div style={{ fontSize:17, fontWeight:700, marginBottom:8 }}>Scanning for events…</div>
              <div style={{ color:'#9CA3AF', fontSize:14 }}>AI is reading your messages</div>
